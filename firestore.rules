rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function logado() { return request.auth != null; }
    function membro(sid) {
      return logado() && request.auth.uid in get(/databases/$(database)/documents/servidores/$(sid)).data.membros;
    }

    // Perfil público mínimo (nome e foto do Google)
    match /usuarios/{uid} {
      allow read: if logado();
      allow write: if logado() && request.auth.uid == uid;
    }

    match /servidores/{sid} {
      // Só membros veem o servidor
      allow read: if logado() && request.auth.uid in resource.data.membros;

      // Criar: você é o dono e o único membro
      allow create: if logado()
        && request.resource.data.dono == request.auth.uid
        && request.resource.data.membros == [request.auth.uid]
        && request.resource.data.nome is string
        && request.resource.data.nome.size() > 0
        && request.resource.data.nome.size() <= 40;

      allow update: if logado() && (
        // Dono pode mudar tudo, menos passar o dono pra outro
        (resource.data.dono == request.auth.uid && request.resource.data.dono == resource.data.dono)
        // Qualquer pessoa com o convite pode se ADICIONAR ou se REMOVER (só a si mesma)
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['membros']) && (
              request.resource.data.membros.toSet().difference(resource.data.membros.toSet()) == [request.auth.uid].toSet()
           || resource.data.membros.toSet().difference(request.resource.data.membros.toSet()) == [request.auth.uid].toSet()
           || request.resource.data.diff(resource.data).affectedKeys().size() == 0))
      );

      allow delete: if logado() && resource.data.dono == request.auth.uid;

      // Quem está na call: cada um só mexe na própria presença
      match /pessoas/{uid} {
        allow read: if membro(sid);
        allow write: if membro(sid) && request.auth.uid == uid;
      }

      // Chat do servidor
      match /mensagens/{msg} {
        allow read: if membro(sid);
        allow create: if membro(sid)
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.texto is string
          && request.resource.data.texto.size() <= 500;
        allow delete: if membro(sid) && resource.data.uid == request.auth.uid;
      }

      // Sinais da conexão de voz/vídeo: só o destinatário lê e apaga
      match /sinais/{sinal} {
        allow create: if membro(sid) && request.resource.data.de == request.auth.uid;
        allow read, delete: if logado() && resource.data.para == request.auth.uid;
      }
    }
  }
}
